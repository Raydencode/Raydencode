# ============================================================================
# Ultron configuration
# Copy this file to .env and fill in real values. Never commit your real .env.
# ============================================================================

# --- LLM backend (required) -------------------------------------------------
# Which brain powers Ultron. Pick ONE:
#   anthropic -> Claude. Best quality, but paid (small per-token cost after a
#                small starting credit grant). Needs ANTHROPIC_API_KEY below.
#   gemini    -> Google Gemini. Free tier, no credit card required. Needs
#                GEMINI_API_KEY below. Recommended if you want free + reliable.
#   ollama    -> Fully local model. Free forever, no account, no internet
#                needed at call time. Needs the Ollama app running locally
#                (see OLLAMA_* below) — no API key. Tool-use is less reliable
#                than the cloud options; depends heavily on which model you run.
LLM_PROVIDER=anthropic

# --- Anthropic (required only if LLM_PROVIDER=anthropic) --------------------
# Get a key at https://console.anthropic.com/ under "API Keys". New accounts
# get a small free credit grant; after that it's pay-as-you-go per token
# (see https://www.anthropic.com/pricing).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Gemini (required only if LLM_PROVIDER=gemini) -------------------
# Get a free key (no card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (only used if LLM_PROVIDER=ollama, no key needed) ---------------
# 1. Install Ollama from https://ollama.com and make sure it's running
#    (it auto-starts a local server after install; `ollama serve` if not).
# 2. Pull a model that supports tool calling. llama3.2 (~3B) is the default
#    here — noticeably faster than llama3.1 (~8B) on CPU-only hardware, at
#    some cost to accuracy: ollama pull llama3.2
#    For better tool-use reliability at the cost of speed: ollama pull llama3.1
# 3. Point OLLAMA_MODEL at whatever you pulled.
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Wake word — Ultron ignores everything until it hears this word, then
# engages with whatever follows (or the next thing you say, if you just
# said the wake word alone).
# WAKE_WORD=ultron

# --- NewsAPI (required, all free tier — no card) -----------------------------
# Powers get_news(). Get a free key at https://newsapi.org/register
# Free "Developer" tier: 100 requests/day, and only works from localhost in
# production mode (fine for this local app).
NEWSAPI_KEY=your_newsapi_key_here

# --- OpenWeatherMap (required, free tier — no card) --------------------------
# Powers get_weather(). Get a free key at https://home.openweathermap.org/users/sign_up
# Free tier: 1,000 calls/day, 60 calls/minute. New keys can take up to a
# couple hours to activate.
OPENWEATHERMAP_KEY=your_openweathermap_key_here

# --- Tavily (required, free tier — no card) -----------------------------------
# Powers web_search(). Get a free key at https://tavily.com (sign up, then
# find it on your dashboard). Free tier: 1,000 searches/month.
TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional tuning ---------------------------------------------------------
# Whisper model size: tiny | base | small | medium | large
# WHISPER_MODEL_SIZE=base

# Path to a Piper voice model .onnx file (see README for download instructions)
# PIPER_VOICE_MODEL_PATH=models/en_US-lessac-medium.onnx

# Dashboard window
# DASHBOARD_WIDTH=900
# DASHBOARD_HEIGHT=900
# DASHBOARD_ALWAYS_ON_TOP=false
# DASHBOARD_FRAMELESS=false

# Push-to-talk key (as understood by the `keyboard` library)
# WAKE_KEY=space

# How many conversation turns to keep in context
# MAX_HISTORY_TURNS=20
