# ============================================================================
# Ultron configuration
# Copy this file to .env and fill in real values. Never commit your real .env.
# ============================================================================

# --- Anthropic (required) ---------------------------------------------------
# Powers Ultron's brain (Claude). Get a key at https://console.anthropic.com/
# under "API Keys". New accounts get a small free credit grant; after that
# it's pay-as-you-go per token (see https://www.anthropic.com/pricing).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- NewsAPI (required) -----------------------------------------------------
# Powers get_news(). Get a free key at https://newsapi.org/register
# Free "Developer" tier: 100 requests/day, and only works from localhost in
# production mode (fine for this local app).
NEWSAPI_KEY=your_newsapi_key_here

# --- OpenWeatherMap (required) ----------------------------------------------
# Powers get_weather(). Get a free key at https://home.openweathermap.org/users/sign_up
# Free tier: 1,000 calls/day, 60 calls/minute. New keys can take up to a
# couple hours to activate.
OPENWEATHERMAP_KEY=your_openweathermap_key_here

# --- Tavily (required) ------------------------------------------------------
# Powers web_search(). Get a free key at https://tavily.com (sign up, then
# find it on your dashboard). Free tier: 1,000 searches/month.
TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional tuning ---------------------------------------------------------
# Whisper model size: tiny | base | small | medium | large
# WHISPER_MODEL_SIZE=base

# Path to a Piper voice model .onnx file (see README for download instructions)
# PIPER_VOICE_MODEL_PATH=models/en_US-lessac-medium.onnx

# Anthropic model id used by brain.py
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Dashboard window
# DASHBOARD_WIDTH=900
# DASHBOARD_HEIGHT=900
# DASHBOARD_ALWAYS_ON_TOP=false
# DASHBOARD_FRAMELESS=false

# Push-to-talk key (as understood by the `keyboard` library)
# WAKE_KEY=space

# How many conversation turns to keep in context
# MAX_HISTORY_TURNS=20
