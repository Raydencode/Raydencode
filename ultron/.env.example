# Copy this file to .env and fill in what you have. ULTRON degrades loudly
# (never silently) for anything left blank — it'll show a badge on screen
# and say so out loud rather than pretend a feature works.
#
#   cp .env.example .env
#   chmod 600 .env

# --- Voice (required for the mic + spoken replies) --------------------
# Put your ElevenLabs API key here so the browser never sees it.
# Get one at https://elevenlabs.io — used for both text-to-speech and
# Scribe speech-to-text.
ELEVENLABS_API_KEY=

# Optional: pick a specific ElevenLabs voice. Defaults to the public
# "Rachel" voice if left blank.
ELEVENLABS_VOICE_ID=

# --- Model (optional — routing to tools works without this) -----------
# Without this, ULTRON still searches/briefs/plans/remembers correctly
# via keyword + file-matching routing, it just can't hold a free-form
# conversation. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Data mode ----------------------------------------------------------
# 1 = demo fixtures (default, safe to screen-record). 0 = your real folders.
ULTRON_DEMO=1

# Comma-separated real folders to index. Only read when ULTRON_DEMO=0.
ULTRON_FOLDERS=

# --- Optional integrations (read-only; leave blank to skip) -----------
# read_inbox / brief_me — IMAP, read-only, headers only.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# brief_me — path to a local .ics file exported from your calendar.
CALENDAR_ICS_PATH=

# --- Server ----------------------------------------------------------
ULTRON_PORT=8420
